# 智谱模型与 Embedding。留空时项目可运行离线降级模式。
ZHIPUAI_API_KEY=
LLM_MODEL=glm-4-flash
EMBEDDING_MODEL=embedding-2

# P03 持久化：Docker Compose 使用 PostgreSQL；本地可改为 sqlite:///data/app.db
DATABASE_URL=postgresql+psycopg://eat_agent:eat_agent@postgres:5432/eat_agent
AUTO_CREATE_SCHEMA=false
APP_ENV=development
APP_VERSION=0.7.0
APP_API_KEY=
AUTH_MODE=auto
JWT_SECRET=
JWT_ISSUER=eat-agent
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
CONVERSATION_TTL_DAYS=30
REDIS_URL=redis://redis:6379/0
REDIS_LOCK_TIMEOUT_SECONDS=30
STRICT_SECURITY=false
METRICS_ENABLED=true
METRICS_API_KEY=
CORS_ORIGINS=*
MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
TOOL_DEFAULT_TIMEOUT_SECONDS=15
TOOL_MAX_ATTEMPTS=3
TOOL_RETRY_BASE_DELAY_MS=200
TOOL_CIRCUIT_FAILURE_THRESHOLD=5
TOOL_CIRCUIT_RECOVERY_SECONDS=30
TOOL_EXECUTOR_MAX_WORKERS=8

# P0-7 可观测性。默认关闭外部追踪，仅保留 JSON 日志和 Prometheus。
OTEL_ENABLED=false
OTEL_SERVICE_NAME=eat-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_CAPTURE_CONTENT=false
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0

# PostgreSQL 容器初始化配置
POSTGRES_DB=eat_agent
POSTGRES_USER=eat_agent
POSTGRES_PASSWORD=eat_agent

# 可选：联网搜索
TAVILY_API_KEY=

# 可选：GraphRAG
USE_GRAPHRAG=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 可选：MCP / Firecrawl
ENABLE_MCP=true
LOCAL_MCP_SERVER=stdio
FIRECRAWL_API_KEY=
