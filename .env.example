# 智谱模型与 Embedding。留空时项目可运行离线降级模式。
ZHIPUAI_API_KEY=
LLM_MODEL=glm-4-flash
EMBEDDING_MODEL=embedding-2

# 可选：联网搜索
TAVILY_API_KEY=

# 可选：GraphRAG
USE_GRAPHRAG=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 可选：MCP / Firecrawl
ENABLE_MCP=true
LOCAL_MCP_SERVER=stdio
FIRECRAWL_API_KEY=
